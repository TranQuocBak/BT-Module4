datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Document {
  id           String   @id @default(uuid())
  userId       String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  filePath     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
